# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
ENVIRONMENT=development

# --- Database ---
POSTGRES_USER=oblitrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oblitrack
DATABASE_URL=postgresql+asyncpg://oblitrack:change-me@localhost:5432/oblitrack

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Document storage ---
# Local filesystem path (outside any web-served root) where uploaded
# contract files are stored, keyed by server-generated org/contract UUIDs.
STORAGE_ROOT=storage

# --- LLM providers ---
# Groq (primary) — https://console.groq.com
GROQ_API_KEY=
# Google Gemini (fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- SMTP (alert emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
